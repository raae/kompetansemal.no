---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
interface Props {
  title?: string;
  description: string;
  /** Kompakt topp (alle sider unntatt forsiden). */
  kompakt?: boolean;
  /** Bredere innholdsflate (oppbyggingen). */
  bred?: boolean;
}
const { title, description, kompakt = true, bred = false } = Astro.props;
const fullTittel = title ? `${title} – Hva betyr målet?` : 'Hva betyr målet? Alle kompetansemål i grunnskolen på vanlig norsk';
const canonical = new URL(Astro.url.pathname, Astro.site);
const sokUrl = new URL('/sok.json', Astro.site).pathname;
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTittel}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={fullTittel} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&display=swap" rel="stylesheet" />
    <!-- Fathom - beautiful, simple website analytics -->
    <script is:inline src="https://cdn.usefathom.com/script.js" data-site="CDYDQILC" defer></script>
    <!-- / Fathom -->
  </head>
  <body>
    <header class:list={['top', { compact: kompakt }]}>
      <div class="wrap">
        <h1><span class="q">{kompakt ? <a href="/">Hva betyr målet?</a> : 'Hva betyr målet?'}</span></h1>
        <slot name="lede" />
        <form class="controls" role="search" action="/" method="get">
          <label class="search">
            <span class="visually-hidden">Søk i alle mål</span>
            <input id="q" name="q" type="search" placeholder="Søk i alle fag, f.eks. brøk eller dikt" autocomplete="off" data-sok={sokUrl} />
          </label>
        </form>
      </div>
    </header>
    <main>
      <div class:list={['wrap', { bred }]} id="innhold"><slot /></div>
      <div class="wrap" id="sok-resultat" hidden aria-live="polite"></div>
    </main>
    <Footer />
    <script>
      import { startSok } from '../scripts/sok';
      startSok();
    </script>
  </body>
</html>
