---
import Valgtpanel from './Valgtpanel.astro';
import { byggerPaaKoder, klosser, maalUrl, trinnLabel, type KlossVariant, type Lag } from '../lib/data';
interface Props { lag: Lag[]; variant: KlossVariant }
const { variant } = Astro.props;
const { kolonner, rader, klosser: alle } = klosser(Astro.props.lag, { kopier: variant === 'kopier' });
---
<div class="klosser-rulle">
  <div class="klosser-flate" id="stabel">
    {variant === 'traader' && <svg class="streker traader" aria-hidden="true"></svg>}
    <ol class="klosser" style={`--kolonner:${kolonner};--rader:${rader}`}>
      {alle.map((k) => (
        <li class:list={[{ kontekst: k.kontekst }]} style={`grid-column:${k.kolonne} / span ${k.bredde};grid-row:${k.rad}`}>
          {k.kopi ? (
            <button type="button" class="blokk kopi" data-kode={k.maal.kode} title={`Kopi: ${k.maal.kode} bygger også på dette målet`}>
              <small>{k.maal.kode} · kopi</small>
              <span>{k.maal.forklaring}</span>
            </button>
          ) : (
            <button type="button" class="blokk" id={k.maal.kode} data-kode={k.maal.kode} data-uten-strek={variant === 'traader' ? k.hoved : undefined} data-bygger={byggerPaaKoder(k.maal).join(' ')} data-trinn={k.maal.trinn} data-url={maalUrl(k.maal)} data-udir={k.maal.udir} data-trinnlabel={trinnLabel(k.maal.fag, k.maal.trinn)}>
              <small>{k.maal.kode} · {trinnLabel(k.maal.fag, k.maal.trinn)}{variant !== 'merker' && k.paa.length > 1 && <b class="flere" title={`Bygger på ${k.paa.length} mål`}> · på {k.paa.length}</b>}</small>
              <span>{k.maal.forklaring}</span>
            </button>
          )}
          {variant === 'merker' && k.paa.length > 0 && (
            <ul class="merker" aria-label="Bygger på">
              {k.paa.map((p, i) => <li><a href={`#${p}`} class:list={['merke', { hoved: i === 0 }]} title={i === 0 ? 'Står oppå dette målet' : 'Bygger også på dette målet'}>{p}</a></li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>
  </div>
</div>
<Valgtpanel />
