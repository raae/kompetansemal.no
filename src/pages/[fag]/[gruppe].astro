---
import Base from '../../layouts/Base.astro';
import GruppeInnhold from '../../components/GruppeInnhold.astro';
import { ALLE_FAG, fagUrl, gruppeUrl, type Fag, type Gruppe } from '../../lib/data';
import { ENGELSK_NAVN, ENGELSK_URL } from '../../lib/engelsk';

export function getStaticPaths() {
  return ALLE_FAG.flatMap((fag) => fag.grupper.map((gruppe) => ({ params: { fag: fag.slug, gruppe: gruppe.slug }, props: { fag, gruppe } })));
}
interface Props { fag: Fag; gruppe: Gruppe }
const { fag, gruppe } = Astro.props;
// Engelskstigen øver på målene i engelsk etter 7. trinn.
const harSpill = fag.key === 'ENG' && gruppe.slug === '5-7';
---
<Base title={`${fag.navn} ${gruppe.label}`} description={`${gruppe.maal.length} kompetansemål i ${fag.navn.toLowerCase()} for ${gruppe.label}, forklart på vanlig norsk.`}>
  <section style={`--fag:var(--${fag.key})`}>
    <div class="fagHead">
      <h2><a href={fagUrl(fag)}>{fag.navn}</a></h2>
      <p>{fag.note}</p>
      <ul class="jump" aria-label="Trinn">
        <li><a href={fagUrl(fag)}>Alle trinn</a></li>
        {fag.grupper.map((g) => <li><a href={gruppeUrl(fag, g)} aria-current={g.slug === gruppe.slug ? 'page' : undefined}>{g.label}</a></li>)}
      </ul>
    </div>
    {harSpill && <p class="spilltips">Vil du øve? <a href={ENGELSK_URL}>{ENGELSK_NAVN}</a> er et lite spill, litt som Duolingo, som øver på flere av målene under.</p>}
    <GruppeInnhold gruppe={gruppe} />
  </section>
</Base>
