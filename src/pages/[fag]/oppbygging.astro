---
import Base from '../../layouts/Base.astro';
import { ALLE_FAG, byggerPaaKoder, fagUrl, gruppeUrl, maalUrl, oppbygging, type Fag } from '../../lib/data';

export function getStaticPaths() {
  return ALLE_FAG.map((fag) => ({ params: { fag: fag.slug }, props: { fag } }));
}
interface Props { fag: Fag }
const { fag } = Astro.props;
// Tidligste trinn nederst, som byggeklosser.
const lag = oppbygging(fag).reverse();
---
<Base title={`Oppbygging i ${fag.navn.toLowerCase()}`} description={`Alle ${fag.antall} kompetansemål i ${fag.navn.toLowerCase()} stablet trinn for trinn, så du ser hva som bygger på hva.`} bred>
  <section style={`--fag:var(--${fag.key})`}>
    <div class="fagHead">
      <h2><a href={fagUrl(fag)}>{fag.navn}</a></h2>
      <p>Målene er stablet med de tidligste nederst. Strekene viser hvilke mål som bygger på hvilke, slik Udir har koblet dem. Trykk på et mål for å se hele kjeden.</p>
      <ul class="jump" aria-label="Trinn">
        <li><a href={fagUrl(fag)}>Alle trinn</a></li>
        {fag.grupper.map((g) => <li><a href={gruppeUrl(fag, g)}>{g.label}</a></li>)}
        <li><a href={`${fagUrl(fag)}oppbygging/`} aria-current="page">Oppbygging</a></li>
      </ul>
    </div>
    <div class="stabel" id="stabel">
      <svg class="streker" aria-hidden="true"></svg>
      {lag.map((l) => (
        <div class="lag">
          <h3 class="lagnavn">{l.label}</h3>
          <ol>
            {l.maal.map((m) => (
              <li>
                <button type="button" class="blokk" id={m.kode} data-kode={m.kode} data-bygger={byggerPaaKoder(m).join(' ')} data-trinn={m.trinn} data-url={maalUrl(m)} data-udir={m.udir} data-trinnlabel={l.label}>
                  <small>{m.kode}</small>
                  <span>{m.forklaring}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
    <aside class="valgtpanel" id="valgt" hidden aria-live="polite">
      <button type="button" class="lukk" aria-label="Fjern markering">×</button>
      <p class="meta"></p>
      <p class="plain"></p>
      <p class="udir"></p>
      <p class="tall"></p>
      <a class="aapne" href="#">Åpne målet →</a>
    </aside>
  </section>
  <script>
    import { startOppbygging } from '../../scripts/oppbygging';
    startOppbygging();
  </script>
</Base>
