---
import Base from '../../layouts/Base.astro';
import Visningsvalg from '../../components/Visningsvalg.astro';
import VisningsFilter from '../../components/VisningsFilter.astro';
import Visualisering from '../../components/Visualisering.astro';
import { ALLE_FAG, fagUrl, type Fag } from '../../lib/data';

export function getStaticPaths() {
  return ALLE_FAG.map((fag) => ({ params: { fag: fag.slug }, props: { fag } }));
}
interface Props { fag: Fag }
const { fag } = Astro.props;
---
<Base title={`Oppbygging i ${fag.navn.toLowerCase()}`} description={`Alle ${fag.antall} kompetansemål i ${fag.navn.toLowerCase()} stablet trinn for trinn, så du ser hva som bygger på hva.`} bred>
  <section style={`--fag:var(--${fag.key})`}>
    <div class="fagHead">
      <div class="fagtopp">
        <h2><a href={fagUrl(fag)}>{fag.navn}</a></h2>
        <Visningsvalg fag={fag} visning="oppbygging" />
      </div>
      <p>Målene er stablet med de tidligste nederst. Strekene viser hvilke mål som bygger på hvilke, slik Udir har koblet dem. Trykk på et mål for å se hele kjeden. Velger du trinn, står det de valgte målene bygger på nederst, tonet ned.</p>
      <VisningsFilter fag={fag} />
    </div>
    <Visualisering fag={fag} form="oppbygging" />
  </section>
</Base>
