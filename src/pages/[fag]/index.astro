---
import Base from '../../layouts/Base.astro';
import GruppeInnhold from '../../components/GruppeInnhold.astro';
import FagNav from '../../components/FagNav.astro';
import { ALLE_FAG, type Fag } from '../../lib/data';

export function getStaticPaths() {
  return ALLE_FAG.map((fag) => ({ params: { fag: fag.slug }, props: { fag } }));
}
interface Props { fag: Fag }
const { fag } = Astro.props;
---
<Base title={fag.navn} description={`Alle ${fag.antall} kompetansemål i ${fag.navn.toLowerCase()} for 1.–10. trinn, forklart på vanlig norsk.`}>
  <section style={`--fag:var(--${fag.key})`}>
    <div class="fagHead">
      <h2>{fag.navn}</h2>
      <p>{fag.note}</p>
      <FagNav fag={fag} visning="liste" />
    </div>
    {fag.grupper.map((g) => <GruppeInnhold gruppe={g} medGruppeOverskrift />)}
  </section>
</Base>
