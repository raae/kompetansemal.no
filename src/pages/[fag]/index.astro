---
import Base from '../../layouts/Base.astro';
import GruppeInnhold from '../../components/GruppeInnhold.astro';
import Filter from '../../components/Filter.astro';
import { ALLE_FAG, kjerneelementerForFag, type Fag } from '../../lib/data';

export function getStaticPaths() {
  return ALLE_FAG.map((fag) => ({ params: { fag: fag.slug }, props: { fag } }));
}
interface Props { fag: Fag }
const { fag } = Astro.props;
const kjerne = kjerneelementerForFag(fag);
---
<Base title={fag.navn} description={`Alle ${fag.antall} kompetansemål i ${fag.navn.toLowerCase()} for 1.–10. trinn, forklart på vanlig norsk.`}>
  <section style={`--fag:var(--${fag.key})`}>
    <div class="fagHead">
      <h2>{fag.navn}</h2>
      <p>{fag.note}</p>
      <Filter navn="trinn" tittel="Trinn" alle={{ label: 'Alle trinn' }} valg={fag.grupper.map((g) => ({ verdi: g.slug, label: g.label }))} />
      <Filter navn="kjerne" tittel="Kjerneelement" alle={{ label: 'Alle kjerneelementer' }} valg={kjerne.map((k) => ({ verdi: k.slug, label: k.navn }))} />
      <p class="filterstatus" data-filter-status aria-live="polite" hidden></p>
    </div>
    <div class="maalliste" data-filtrert>
      {fag.grupper.map((g) => <GruppeInnhold gruppe={g} medGruppeOverskrift />)}
    </div>
  </section>
  <script>
    import { startFilter } from '../../scripts/filter';
    startFilter();
  </script>
</Base>
