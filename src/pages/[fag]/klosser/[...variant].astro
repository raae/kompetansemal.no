---
import Base from '../../../layouts/Base.astro';
import KlossFaner from '../../../components/KlossFaner.astro';
import Visningsvalg from '../../../components/Visningsvalg.astro';
import VisningsFilter from '../../../components/VisningsFilter.astro';
import Visualisering from '../../../components/Visualisering.astro';
import { ALLE_FAG, fagUrl, type Fag } from '../../../lib/data';
import { KLOSS_VARIANTER, type KlossVariant } from '../../../lib/visning/modell';

export function getStaticPaths() {
  return ALLE_FAG.flatMap((fag) =>
    KLOSS_VARIANTER.map((v) => ({ params: { fag: fag.slug, variant: v.slug === 'tre' ? undefined : v.slug }, props: { fag, variant: v.slug } })),
  );
}
interface Props { fag: Fag; variant: KlossVariant }
const { fag, variant } = Astro.props;
---
<Base title={`Klosser i ${fag.navn.toLowerCase()}`} description={`Alle ${fag.antall} kompetansemål i ${fag.navn.toLowerCase()} som klosser: hvert mål står oppå det det bygger på.`} bred>
  <section style={`--fag:var(--${fag.key})`}>
    <div class="fagHead">
      <div class="fagtopp">
        <h2><a href={fagUrl(fag)}>{fag.navn}</a></h2>
        <Visningsvalg fag={fag} visning="klosser" />
      </div>
      <p>Hvert mål står oppå det det bygger på. Fanene viser ulike måter å vise mål som bygger på flere mål. Trykk på et mål for å se hele kjeden.</p>
      <VisningsFilter fag={fag} />
      <KlossFaner fag={fag} variant={variant} />
    </div>
    <Visualisering fag={fag} form={variant} />
  </section>
</Base>
